<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/hisab_background" />
    <item
        android:gravity="top|start"
        android:left="-90dp"
        android:top="-40dp">
        <shape android:shape="oval">
            <size
                android:width="300dp"
                android:height="300dp" />
            <gradient
                android:centerColor="#18FFF5C6"
                android:endColor="#00FFFFFF"
                android:gradientRadius="200dp"
                android:startColor="#18FFC76A"
                android:type="radial" />
        </shape>
    </item>
    <item
        android:gravity="bottom|end"
        android:right="-80dp"
        android:bottom="-40dp">
        <shape android:shape="oval">
            <size
                android:width="300dp"
                android:height="300dp" />
            <gradient
                android:centerColor="#14FFF0BF"
                android:endColor="#00FFFFFF"
                android:gradientRadius="200dp"
                android:startColor="#18F6C447"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
